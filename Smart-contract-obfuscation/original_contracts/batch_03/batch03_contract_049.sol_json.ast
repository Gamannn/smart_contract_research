          "id": 567,
          "name": "FunctionDefinition",
          "src": "11923:381:0"
        },
        {
          "attributes":
          {
            "documentation": "@dev Safely transfers the ownership of a given token ID to another address\nIf the target address is a contract, it must implement `onERC721Received`,\nwhich is called upon a safe transfer, and return the magic value\n`bytes4(keccak256(\"onERC721Received(address,address,uint256,bytes)\"))`; otherwise,\nthe transfer is reverted.\n\n   * Requires the msg sender to be the owner, approved, or operator\n@param from current owner of the token\n@param to address to receive the ownership of the given token ID\n@param tokenId uint256 ID of the token to be transferred",
            "implemented": true,
            "isConstructor": false,
            "kind": "function",
            "modifiers":
            [
              null
            ],
            "name": "safeTransferFrom",
            "scope": 866,
            "stateMutability": "nonpayable",
            "superFunction": 308,
            "visibility": "public"
          },
